# Coaching Hub runs entirely on free tiers: Firebase Spark plan + Vercel Hobby, or the
# Firebase emulators on your own computer. Nothing here costs money.

# ─── App ──────────────────────────────────────────────
# The name shown in the sidebar, login page and messages. Change it here only.
NEXT_PUBLIC_APP_NAME="Coaching Hub"
# Shown under page titles, e.g. "HSC 26"
NEXT_PUBLIC_SESSION_LABEL="HSC 26"

# ─── Option A: local emulators (no Firebase account needed) ───
# Copy this block into .env.local, then run `npm run emulators` and `npm run dev` (see README).
# NEXT_PUBLIC_USE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-coaching
# NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
# FIREBASE_PROJECT_ID=demo-coaching
# Password for the local admin account that `npm run seed:admin` creates (emulator only).
# LOCAL_ADMIN_PASSWORD=change-me-to-something-long

# ─── Option B: a real Firebase project on the free Spark plan ───
# Web app config (Project settings → General → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Project settings → Service accounts → Generate new private key)
# Server-only. Never prefix these with NEXT_PUBLIC_. Also used to sign student/guardian logins.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON, keeping the \n sequences, wrapped in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Access ───────────────────────────────────────────
# Comma-separated emails that become center admins on first login.
ADMIN_EMAILS=you@example.com

# ─── Fees ─────────────────────────────────────────────
# Guardians can try a demo online payment. It records a payment marked "Demo" and moves
# no real money. Set to false to hide it.
DEMO_PAYMENTS=true
