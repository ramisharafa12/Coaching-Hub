# ─── App ──────────────────────────────────────────────
# The name shown in the sidebar, login page and SMS. Change it here only.
NEXT_PUBLIC_APP_NAME="Coaching Hub"
# Shown under page titles, e.g. "HSC 26"
NEXT_PUBLIC_SESSION_LABEL="HSC 26"

# ─── Firebase web app (Project settings → General → Your apps → Web app) ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (Project settings → Service accounts → Generate new private key) ───
# Server-only. Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON, keeping the \n sequences, wrapped in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Access ───────────────────────────────────────────
# Comma-separated emails that become center admins on first login.
ADMIN_EMAILS=you@example.com

# ─── SMS ──────────────────────────────────────────────
# "log"  = don't send; just record every message in the smsLog collection (default, free).
# "http" = send through any Bangladeshi SMS gateway that accepts a GET/POST URL.
SMS_PROVIDER=log
# Used when SMS_PROVIDER=http. {number} becomes 8801XXXXXXXXX and {message} the URL-encoded text.
# Copy the exact URL format from your gateway's API docs.
SMS_API_URL="https://your-sms-gateway.example/api/send?api_key=YOUR_KEY&senderid=YOUR_ID&number={number}&message={message}"
SMS_HTTP_METHOD=GET

# ─── Local emulators (optional, for free local development) ───
# NEXT_PUBLIC_USE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
